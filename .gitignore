# Widget Preview related
.widget_preview/

# Marketing working files.
#
# The App Store package is built by the scripts in marketing/build_*.mjs
# from screen recordings captured off a real device. What is tracked is
# the finished article — the store screenshots, the preview videos, the
# ASO document — and the scripts that produce them. What is ignored is
# everything in between: the raw captures, the per-beat ffmpeg clips,
# and the zips, which only re-package the folders sitting beside them.
# Around 142MB of the 242MB on disk, none of it worth carrying in every
# future clone.
marketing/raw/
marketing/raw_ios/
marketing/ios_clean/
# Genuine iOS Simulator captures from capture_ios.sh — regenerated, not
# versioned, same as every other capture directory above.
marketing/raw_ios_device/
marketing/video/
marketing/*.zip

# marketing/build is where the package is assembled, so most of it is
# throwaway — the rendered screenshot HTML, the per-beat frames, the
# ffmpeg scratch dirs. The scripts and the data they read are not: they
# are how the whole package gets rebuilt after the next UI change.
marketing/build/*
!marketing/build/*.mjs
!marketing/build/*.json
!marketing/build/*.txt
!marketing/build/*.sh

# Node lives here only to run ffmpeg-static and sharp for those scripts.
marketing/node_modules/
tool/node_modules/

# Android signing material. Committing a keystore hands anyone with repo
# access the ability to publish updates to the Play listing under this
# identity, and Play will not accept a replacement key without a support
# escalation — so this one stays out, and so does anything shaped like
# it.
android/Lernova_keystore
*.jks
*.keystore
android/key.properties

# Firebase config. google-services.json and GoogleService-Info.plist are
# not secrets in the credential sense — they ship inside the binary —
# but they tie the repo to one Firebase project, so they are kept with
# the release material rather than in source control.
android/app/google-services.json
ios/GoogleService-Info.plist
