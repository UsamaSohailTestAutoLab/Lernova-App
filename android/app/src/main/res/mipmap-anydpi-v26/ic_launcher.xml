<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon (API 26+). Without this, launchers that support adaptive
  icons (Pixel Launcher included) treat the flat ic_launcher.png as an
  ad-hoc "foreground" and inset it a second time on top of whatever
  padding it already has, shrinking it far more than intended. This file
  gives the OS the real foreground/background pair so it masks and
  composites them itself, at the correct scale, on every icon shape.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
